<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PGAssetTool.Gui.ViewModels"
        xmlns:ctl="using:PGAssetTool.Gui.Controls"
        xmlns:pack="using:PGAssetTool.Core.Pack"
        xmlns:mods="using:PGAssetTool.Core.Mods"
        x:Class="PGAssetTool.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/pgat.ico"
        Width="1360" Height="820" MinWidth="900" MinHeight="560">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    </Style>
    <Style Selector="TextBlock.pending">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="460" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- White over whatever is behind it rather than a colour of its own: the same band has to read
         as lifted both in the dropdown and in the closed box, and those are not the same shade.
         Two weights, and a row is never given both — what is worn is one of the skins. -->
    <Style Selector="Border.skin">
      <Setter Property="Background" Value="#10FFFFFF" />
    </Style>
    <Style Selector="Border.worn">
      <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <!-- The row and its expander are the same click: this tool asks for a great many of them. -->
    <Style Selector="TreeViewItem" x:DataType="vm:TreeNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <!-- Shared: the browse pane and both halves of the editor comparison show the same thing. -->
    <DataTemplate DataType="vm:PreviewViewModel">
      <DockPanel>
      
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <!-- What the model can be made to do. Only the clips that move this mesh are offered: a
               weapon's prefab carries animations for the muzzle flash and the shell casing too, and
               one of those plays as a model sitting perfectly still. -->
          <Grid ColumnDefinitions="*,auto" IsVisible="{Binding HasClips}" Margin="0,0,0,4">
            <ComboBox Grid.Column="0" ItemsSource="{Binding Clips}" SelectedItem="{Binding Clip}"
                      HorizontalAlignment="Stretch" PlaceholderText="Play an animation">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MotionChoice">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Detail}" Classes="dim mono" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleButton Grid.Column="1" IsChecked="{Binding Playing}" Margin="4,0,0,0"
                          Padding="10,3" Content="▶" ToolTip.Tip="Play or hold" />
          </Grid>

          <!-- Where in the clip it is, and a way to stop somewhere. An animation worth looking at
               closely is worth looking at one frame at a time. -->
          <Slider Value="{Binding Time, Mode=TwoWay}" Minimum="0" Maximum="{Binding Length}"
                  IsVisible="{Binding HasClips}" Margin="0,0,0,4" />

          <!-- Applies one texture to the whole model: the question it answers is what this mesh
               looks like wearing another skin, and a skin is not per-submesh. -->
          <ComboBox ItemsSource="{Binding TextureChoices}" SelectedItem="{Binding ChosenTexture}"
                    IsVisible="{Binding HasMesh}" HorizontalAlignment="Stretch" Margin="0,0,0,4">
            <ComboBox.ItemTemplate>
              <!-- Lit for the textures this mesh is already drawn with, and fainter for the rest of
                   this weapon's skins. The list is ordered so those come first, but an order only
                   says something once you have read the whole list; this says it at a glance, and
                   keeps saying it once one is picked. -->
              <DataTemplate DataType="vm:TextureChoice">
                <Border Classes.worn="{Binding Worn}" Classes.skin="{Binding Skin}"
                        CornerRadius="3" Padding="5,1" Margin="-5,-1">
                  <TextBlock Text="{Binding Name}" />
                </Border>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- Named angles, for when the same view is wanted twice: comparing a change against the
               original, or taking the same picture of two weapons. Turning by hand is how a model
               is looked at and a poor way to arrive anywhere exact. -->
          <ItemsControl ItemsSource="{Binding Views}" IsVisible="{Binding HasMesh}" Margin="0,0,0,4">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ViewPreset">
                <Button Content="{Binding Name}" Margin="0,0,4,4" Padding="8,3" FontSize="11"
                        Command="{Binding $parent[ItemsControl].((vm:PreviewViewModel)DataContext).LookCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="Show alpha" IsChecked="{Binding ShowAlpha}"
                    IsVisible="{Binding CanToggleAlpha}" Margin="0,0,0,4" />
          <!-- Nothing plays until asked: moving down a weapon's six sounds would otherwise set six
               of them off. -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSound}"
                      Margin="0,0,0,4">
            <Button Content="▶  Play" Command="{Binding PlayCommand}" />
            <Button Content="■" Command="{Binding SilenceCommand}" ToolTip.Tip="Stop" />
          </StackPanel>
          <TextBlock Text="{Binding Caption}" Classes="dim mono" TextWrapping="Wrap" />
        </StackPanel>
      
        <Border Background="#111113" CornerRadius="4">
          <Panel>
            <TextBlock Text="{Binding Nothing}" Classes="dim"
                       IsVisible="{Binding Nothing, Converter={x:Static ObjectConverters.IsNotNull}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="300" TextAlignment="Center" />
      
            <Panel IsVisible="{Binding ShowAlpha}">
              <Panel.Background>
                <DrawingBrush TileMode="Tile" SourceRect="0,0,16,16" DestinationRect="0,0,16,16"
                              Stretch="None">
                  <DrawingBrush.Drawing>
                    <DrawingGroup>
                      <GeometryDrawing Brush="#2a2a2e" Geometry="M0,0 L16,0 16,16 0,16 Z" />
                      <GeometryDrawing Brush="#1a1a1d" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z" />
                    </DrawingGroup>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Panel.Background>
            </Panel>
      
            <Image Source="{Binding Image}" IsVisible="{Binding HasImage}"
                   Stretch="Uniform" Margin="12"
                   RenderOptions.BitmapInterpolationMode="None" />
      
            <ctl:MeshView Mesh="{Binding Mesh}" Textures="{Binding MeshTextures}"
                          Framing="{Binding Rest}" Standing="{Binding Standing}"
                          Camera="{Binding Camera, Mode=TwoWay}"
                          IsVisible="{Binding HasMesh}" />

            <ctl:WaveformView Sound="{Binding Sound}" IsVisible="{Binding HasSound}"
                              Margin="12" />
          </Panel>
        </Border>
      </DockPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Declared on the window, not as HotKey on each menu item. A HotKey is registered when the
       item carrying it is built, and the items inside a menu are not built until that menu is first
       opened - so every shortcut was dead until its own menu had been pulled down once.

       Digits are spelled D1..D3 because a bare "Ctrl+1" parses as the Key whose numeric value is 1,
       so Ctrl+3 was quietly taking over Ctrl+Tab. The items below keep InputGesture, which only
       prints the shortcut beside the item and registers nothing. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExtractWeaponCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExtractSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenWorkspaceCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RescanWorkspacesCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ToggleReplaceableOnlyCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ShowBrowseCommand}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding ShowEditorCommand}" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding ShowManagerCommand}" />
  </Window.KeyBindings>

  <!-- Everything below is drawn at the scale Options asks for. A transform that takes part in the
       layout rather than one laid over the top of it: at 125% the columns, the paddings and the text
       all grow together, which a larger font on its own does not do — it grows the words inside
       columns that stayed the width they were. At 100 the content measures and arranges exactly as
       it did before this was here. The content keeps its own indentation. -->
  <LayoutTransformControl>
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
    </LayoutTransformControl.LayoutTransform>

  <DockPanel>

    <!-- The checkable items are bound one way and toggled by their command: a checkable MenuItem
         owns its own IsChecked, and a two-way binding lets whatever it holds when the menu is first
         opened overwrite the value the model started with. -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Extract _item" Command="{Binding ExtractWeaponCommand}"
                  InputGesture="Ctrl+E" />
        <MenuItem Header="Extract _selected asset" Command="{Binding ExtractSelectedCommand}"
                  InputGesture="Ctrl+Shift+E" />
        <MenuItem Header="Open _output folder" Command="{Binding OpenWorkspaceCommand}"
                  InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="_Options…" Click="OnOptions" InputGesture="Ctrl+OemComma" />
        <MenuItem Header="Open the _log folder" Command="{Binding OpenLogsCommand}"
                  ToolTip.Tip="Where errors and crash reports are written. Send these with a bug report." />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" InputGesture="Alt+F4" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Find" Command="{Binding FocusSearchCommand}"
                  InputGesture="Ctrl+F" />
        <MenuItem Header="_Reload from disk" Command="{Binding ReloadCommand}"
                  InputGesture="Ctrl+R" />
        <MenuItem Header="Rescan _workspaces" Command="{Binding RescanWorkspacesCommand}"
                  InputGesture="F5" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Replaceable only" ToggleType="CheckBox"
                  IsChecked="{Binding ReplaceableOnly, Mode=OneWay}"
                  Command="{Binding ToggleReplaceableOnlyCommand}"
                  InputGesture="Ctrl+Shift+R" />
        <!-- Whichever pane is in front, not the browse one: the editor shows pictures too, and the
             question the toggle answers is about the picture being looked at. -->
        <MenuItem Header="Show _alpha" ToggleType="CheckBox"
                  IsChecked="{Binding Showing.ShowAlpha, Mode=OneWay}"
                  IsEnabled="{Binding Showing.CanToggleAlpha}"
                  Command="{Binding ToggleAlphaCommand}"
                  InputGesture="Shift+A" />
        <Separator />
        <MenuItem Header="_Browse" Command="{Binding ShowBrowseCommand}"
                  InputGesture="Ctrl+D1" />
        <MenuItem Header="_Editor" Command="{Binding ShowEditorCommand}"
                  InputGesture="Ctrl+D2" />
        <MenuItem Header="_Manager" Command="{Binding ShowManagerCommand}"
                  InputGesture="Ctrl+D3" />
      </MenuItem>
    </Menu>

    <!-- A game update replaces the bundles the mods were written into, so they are simply not in
         the game any more while the manager goes on listing them as on. Said across the top, where
         it cannot be missed on the one occasion it matters. -->
    <Border DockPanel.Dock="Top" Background="#3b2f12" Padding="12,8"
            IsVisible="{Binding UpdateNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Content="Reapply everything" Command="{Binding ReapplyAfterUpdateCommand}" />
          <Button Content="Not now" Command="{Binding DismissUpdateCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding UpdateNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Once, after a session that ended in a crash: the report it left is what to send. -->
    <Border DockPanel.Dock="Top" Background="#3b1616" Padding="12,8"
            IsVisible="{Binding CrashNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Content="Show the report" Command="{Binding OpenLogsCommand}" />
          <Button Content="Dismiss" Command="{Binding DismissCrashCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding CrashNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="26" Background="#18181b" Padding="10,0">
      <Grid ColumnDefinitions="Auto,*">
        <ProgressBar Grid.Column="0" Width="80" Height="3" Margin="0,0,10,0"
                     IsIndeterminate="True" IsVisible="{Binding Working}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="dim" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TabControl SelectedIndex="{Binding Workspace}" Padding="0">

      <TabItem Header="Browse">
        <Grid ColumnDefinitions="300,4,*">

          <DockPanel Grid.Column="0" Margin="10">
            <!-- Which of the game's kinds the list is showing. Weapons are what this opens on and
                 what most of it is for; the rest of the game's cosmetics are the same arrangement
                 under other names, so the only thing that changes below is what is in the list.
                 Hidden for a game with nothing but weapons in it. -->
            <ComboBox Name="Kinds" DockPanel.Dock="Top" ItemsSource="{Binding Kinds}"
                      SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                      IsVisible="{Binding OffersKinds}" />
            <TextBox Name="Search" DockPanel.Dock="Top" Text="{Binding Search}"
                     Watermark="Search" Margin="0,0,0,8" />
            <ListBox Name="Weapons" ItemsSource="{Binding Weapons}" SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WeaponListItem">
                  <!-- The number's column is as wide as the number: only weapons have one, and a
                       fixed width left every hat's name indented past an empty column. -->
                  <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Number}" Classes="dim mono" MinWidth="52"
                               VerticalAlignment="Center" IsVisible="{Binding IsNumbered}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Prefab}" Classes="dim mono"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <GridSplitter Grid.Column="1" Background="#27272a" />

          <Grid Grid.Column="2" ColumnDefinitions="*,4,420" Margin="10">

            <ContentControl Grid.Column="0" Content="{Binding Detail}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:WeaponDetailViewModel">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="4">
                      <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Subtitle}" Classes="dim mono" />

                      <!-- Which skin extraction should write out as well as the weapon's own files.
                           One at a time: a weapon carries up to a dozen, each with its own
                           materials and textures and sometimes a whole model. -->
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                  IsVisible="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).HasSkins}">
                        <TextBlock Text="Extract with skin" Classes="dim" VerticalAlignment="Center" />
                        <ComboBox MinWidth="240"
                                  ItemsSource="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).SkinChoices}"
                                  SelectedItem="{Binding $parent[TabItem].((vm:MainViewModel)DataContext).ChosenSkin}" />
                      </StackPanel>
                    </StackPanel>

                    <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}">
                      <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:TreeNode" ItemsSource="{Binding Children}">
                          <Grid ColumnDefinitions="20,Auto,Auto" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="dim"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                          </Grid>
                        </TreeDataTemplate>
                      </TreeView.ItemTemplate>
                    </TreeView>
                  </DockPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <GridSplitter Grid.Column="1" Background="#27272a" />

            <ContentControl Grid.Column="2" Content="{Binding Preview}" />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Editor">
        <Panel DataContext="{Binding Editor}" x:DataType="vm:EditorViewModel">
        <Grid ColumnDefinitions="260,4,320,4,*" Margin="10">

          <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <!-- Beside the list it acts on, and last in the row so it is not what the pointer
                   lands on first. What it deletes is a folder of somebody's work. -->
              <!-- Held off the splitter: flush against it, with the same background, the button
                   read as part of the bar rather than as something to press. -->
              <Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DeleteCommand}"
                      IsVisible="{Binding CanPack}" Padding="8,2" Margin="0,0,8,0"
                      ToolTip.Tip="Deletes the selected workspace folders and everything in them." />
              <TextBlock Text="Extracted" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="dim"
                       TextWrapping="Wrap" Margin="0,6,0,0" />

            <!-- What the pack will say about itself. The folder name is what the built .pgmod is
                 called, so it belongs beside the rest rather than being a property of the disk. -->
            <Expander DockPanel.Dock="Bottom" Header="Pack details" Margin="0,8,0,0"
                      IsVisible="{Binding CanPack}">
              <!-- The buttons are docked and the fields scroll, so a short window loses the middle
                   of the form rather than the way out of it. Docked first, which is what gives them
                   their height before anything else is measured: without that the whole form was
                   simply clipped and Save went off the bottom of the window. -->
              <DockPanel MaxHeight="360">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                            Margin="0,8,0,0">
                  <Button Content="Save" Command="{Binding ApplyDetailsCommand}" />
                  <Button Content="Revert" Command="{Binding RevertDetailsCommand}" />
                  <Button Content="Copy Discord post" Click="OnCopyForumPost"
                          ToolTip.Tip="Copies a post for the mod forum: name, author, version, description, skin, what it changes, and the game and tool versions. Add your own previews." />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="6" Margin="0,6,12,0">
                <!-- Three names looked like three settings. They are one setting, one working
                     detail and one thing the tool keeps to itself, and saying which is which is
                     most of the fix. -->
                <TextBlock Text="Mod name" Classes="dim" />
                <TextBox Text="{Binding PackName}" />
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="{Binding PackFileName, StringFormat='What the mod is called: shown in the manager, and built as {0}'}" />

                <TextBlock Text="Folder" Classes="dim" Margin="0,6,0,0" />
                <TextBox Text="{Binding FolderName}" />
                <TextBlock Text="Where you work on it. Nothing outside this list sees it."
                           Classes="dim" TextWrapping="Wrap" />

                <TextBlock Text="Author" Classes="dim" Margin="0,6,0,0" />
                <TextBox Text="{Binding PackAuthor}" />
                <TextBlock Text="Version" Classes="dim" />
                <TextBox Text="{Binding PackVersion}" />
                <TextBlock Text="Description" Classes="dim" />
                <TextBox Text="{Binding PackDescription}" AcceptsReturn="True" Height="60"
                         TextWrapping="Wrap" />
                <TextBlock Text="Icon" Classes="dim" />
                <ComboBox ItemsSource="{Binding IconChoices}" SelectedItem="{Binding IconFile}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Shown beside the mod wherever it is listed. The weapon's own icon to begin with. Saved as soon as it is chosen." />
                <TextBlock Text="Protection" Classes="dim" Margin="0,6,0,0" />
                <ComboBox ItemsSource="{Binding ProtectChoices}" SelectedItem="{Binding SelectedProtect}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Signs it and keeps it from opening as a zip. Saved as soon as it is chosen.">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProtectChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="The icon and protection are saved the moment they are chosen. The text above waits for Save." />

                <TextBlock Text="{Binding PackId, StringFormat='id: {0}'}" Classes="dim mono"
                           Margin="0,6,0,0" />
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="How the tool recognises this mod again. Installing a pack replaces whatever is already installed under the same id, so renaming the mod still updates it rather than leaving two." />
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Expander>

            <!-- Multiple, so a click still replaces the selection and Ctrl or Shift extends it:
                 the ordinary list behaviour, which needs no explaining. Building six packs one at a
                 time is six trips through the same three controls. -->
            <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                     SelectedItems="{Binding Selection}" SelectionMode="Multiple">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkspaceItem">
                  <StackPanel Margin="0,2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Classes="dim" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <GridSplitter Grid.Column="1" Background="#27272a" />

          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Files" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="pack:WorkspaceFile">
                  <Grid ColumnDefinitions="16,*" Margin="0,2">
                    <!-- A pencil marks what would go into a pack: packing keeps only the files
                         whose contents differ from what was written out. -->
                    <TextBlock Grid.Column="0" Text="✎" IsVisible="{Binding Edited}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Folder}" Classes="dim mono" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <GridSplitter Grid.Column="3" Background="#27272a" />

          <DockPanel Grid.Column="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
              <Button Content="Build pack" Command="{Binding PackCommand}"
                      IsEnabled="{Binding CanPack}" />
              <Button Content="Build and apply" Command="{Binding PackAndApplyCommand}"
                      IsEnabled="{Binding CanPack}" />
              <CheckBox Content="Side by side" IsChecked="{Binding SideBySide}"
                        VerticalAlignment="Center" />
              <!-- Applies to flipping as well as to the two panes: a flip between views at
                   different angles compares the angles rather than the models. -->
              <CheckBox Content="Linked" IsChecked="{Binding Linked}" VerticalAlignment="Center"
                        ToolTip.Tip="Turn both halves together, and put the same texture on both." />
              <Button Content="Flip" Command="{Binding FlipCommand}"
                      IsVisible="{Binding !SideBySide}" />
              <!-- The icon the export draws is of the vanilla weapon; this one is the mod, from
                   whatever angle the model has been turned to. -->
              <Button Content="Use this view as the icon" Click="OnCaptureIcon"
                      IsVisible="{Binding Shown.HasMesh}" />
            </StackPanel>

            <!-- An animation is replaced by another of the game's own: whose, and which of
                 theirs. Typed rather than picked from a list of fifteen hundred weapons, the same
                 way the browse list is searched. -->
            <Border DockPanel.Dock="Top" IsVisible="{Binding IsAnimation}" Background="#18181b"
                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding AnimationSays}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,8,180,8,*,8,Auto,8,Auto">
                  <TextBlock Grid.Column="0" Text="Use the animation of" VerticalAlignment="Center" />
                  <TextBox Grid.Column="2" Text="{Binding FromQuery}" Watermark="number, name or id"
                           ToolTip.Tip="Any item: a weapon's number or any of its names, or another item's id or name." />
                  <ComboBox Grid.Column="4" ItemsSource="{Binding FromClips}" SelectedItem="{Binding FromClip}"
                            HorizontalAlignment="Stretch" />
                  <Button Grid.Column="6" Content="Use" Command="{Binding UseAnimationCommand}"
                          ToolTip.Tip="Puts that animation in place of this one, fitted to this item's bones. The file changes, so the next pack carries it." />
                  <Button Grid.Column="8" Content="Put the original back" Command="{Binding RestoreAnimationCommand}" />
                </Grid>
                <TextBlock Text="{Binding FromFound}" Classes="dim" />
                <!-- An animation made somewhere else: Blender, mostly. Written out with the item's
                     models on its bones, and read back by the name of the clip it is for. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Write a .glb to edit" Command="{Binding ExportAnimationsCommand}"
                          ToolTip.Tip="Writes every animation of this workspace, with the item's models on the bones they move, into animations/animations.glb — to open in Blender." />
                  <Button Content="Use a .glb…" Command="{Binding UseGlbCommand}"
                          ToolTip.Tip="Puts in an animation from a glTF Binary file: the one named like this animation, or the only one there is. Dropping a .glb on the window does the same." />
                  <ComboBox ItemsSource="{Binding GlbTakes}" SelectedItem="{Binding GlbTake}"
                            IsVisible="{Binding HasGlbTakes}" MinWidth="160"
                            ToolTip.Tip="The file's other animations. Choosing one puts it in instead." />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Stacked, not side by side: textures here are square far more often than not, and
                 the pane is taller than it is wide, so two squares across each get half the room. -->
            <Grid RowDefinitions="*,8,*" IsVisible="{Binding SideBySide}">
              <ContentControl Grid.Row="0" Content="{Binding Original}" />
              <ContentControl Grid.Row="2" Content="{Binding Edited}" />
            </Grid>

            <ContentControl Content="{Binding Shown}" IsVisible="{Binding !SideBySide}" />
          </DockPanel>
        </Grid>

        <!-- Deleting a workspace says what it is about to do first, the way anything that rewrites
             the game does. Same shape as the manager's, and the DataContext stays on the editor
             throughout for the same reason: the buttons are its commands. -->
        <Border IsVisible="{Binding Asking, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#cc09090b">
          <Border Background="#18181b" CornerRadius="6" Padding="20" MaxWidth="460"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Asking.Title}" FontSize="16" FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Asking.Body}" Classes="dim" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding DismissCommand}" />
                <Button Content="Go ahead" Command="{Binding ProceedCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>
        </Panel>
      </TabItem>

      <TabItem Header="Manager">
        <Panel DataContext="{Binding Manager}" x:DataType="vm:ManagerViewModel">
          <Grid ColumnDefinitions="210,4,*,4,420" Margin="10">

            <!-- The shelf the packs are filed on, which is the arrangement they are in on disk:
                 a folder per weapon, one per look inside it. Picking one narrows the tiles rather
                 than moving anything, so what a command acts on is always what is on screen. -->
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="Filed under" FontWeight="SemiBold"
                         Margin="0,0,0,6" />
              <!-- The same search the weapon list does, so a weapon is found by any of its names
                   in any language — and by what a mod says about itself, for one that was not made
                   from a weapon at all. -->
              <TextBox Name="ShelfSearch" DockPanel.Dock="Top" Text="{Binding FolderSearch}"
                       Margin="0,0,0,6" Watermark="Search installed" />
              <TreeView ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:ModFolder" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Label}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="dim mono"
                                 Margin="8,0,0,0" />
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="#27272a" />

            <DockPanel Grid.Column="2">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="Turn on" Command="{Binding EnableCommand}" />
                <Button Content="Turn off" Command="{Binding DisableCommand}" />
                <!-- Says which of the two it will do: with shift held the pack file goes as well. -->
                <Button Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}"
                        ToolTip.Tip="Takes the mod out of the game. Hold shift to delete its pack as well." />
                <Button Content="Reapply all" Command="{Binding ReapplyCommand}" />
                <Button Content="Check every bundle" Command="{Binding CheckEverythingCommand}" />
                <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding Order}" MinWidth="130"
                          ToolTip.Tip="What the tiles are arranged by.">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:ModOrder">
                      <TextBlock Text="{Binding Converter={x:Static vm:ModOrderName.Instance}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="dim"
                         TextWrapping="Wrap" Margin="0,8,0,0" />

              <!-- Tiles rather than rows. What is installed is a handful of weapons, and a picture
                   of the weapon says which one at a glance where a line of text does not. The
                   detail moves to the tooltip: it is what somebody checks once, not what they scan
                   the list for. -->
              <ListBox Name="Installed" ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}"
                       SelectedItems="{Binding Selection}" SelectionMode="Multiple">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:InstalledRow">
                    <StackPanel Width="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).TileWidth}"
                                ToolTip.Tip="{Binding Detail}">
                      <Border Width="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).TileSize}"
                              Height="{Binding $parent[ListBox].((vm:ManagerViewModel)DataContext).TileSize}"
                              Background="#111113" CornerRadius="4">
                        <Panel>
                          <TextBlock Text="?" Classes="dim" FontSize="28"
                                     IsVisible="{Binding !HasIcon}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"
                                 Stretch="Uniform" Margin="4"
                                 RenderOptions.BitmapInterpolationMode="HighQuality" />

                          <!-- A mod that is installed but switched off is still a tile, so the
                               difference has to be visible without reading anything. -->
                          <Border IsVisible="{Binding !Enabled}" Background="#a0111113"
                                  CornerRadius="4" />
                          <TextBlock Text="off" Classes="dim mono" IsVisible="{Binding !Enabled}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Border>

                      <TextBlock Text="{Binding Name}" Margin="0,5,0,0" TextAlignment="Center"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" Background="#27272a" />

            <DockPanel Grid.Column="4">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="The game" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Close it" Command="{Binding CloseGameCommand}"
                          IsEnabled="{Binding GameIsRunning}" />
                  <Button Content="Start it" Command="{Binding LaunchGameCommand}"
                          IsEnabled="{Binding !GameIsRunning}" />
                </StackPanel>
                <TextBlock Text="Running now — its bundles are open." Classes="dim"
                           IsVisible="{Binding GameIsRunning}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <CheckBox Content="Ask before changing the game" IsChecked="{Binding ConfirmChanges}" />
                <TextBlock Text="{Binding Backups}" Classes="dim mono" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>

              <!-- What the pack says about itself. The ledger keeps only what is needed to undo an
                   install; everything the author wrote lives in the pack, and is what somebody
                   deciding whether to keep a mod actually wants to read. -->
              <!-- Capped and scrolling for the same reason as the editor's form: docked to the
                   bottom of a short window it would otherwise take the whole column and leave the
                   bundle list with nothing. -->
              <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10" CornerRadius="4"
                      Background="#18181b" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="3" DataContext="{Binding Details}" x:DataType="vm:ModDetails">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Summary}" Classes="dim" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                             IsVisible="{Binding HasDescription}" />

                  <TextBlock Text="{Binding Changes}" Classes="dim" Margin="0,6,0,0" />
                  <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Replaces}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="dim mono" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <TextBlock Text="{Binding Signature}" Classes="dim" Margin="0,6,0,0"
                             TextWrapping="Wrap" />
                  <TextBlock Text="Installing it is still allowed; it simply is not what its author built."
                             Classes="dim" TextWrapping="Wrap" IsVisible="{Binding WasAltered}" />

                  <TextBlock Text="{Binding Id, StringFormat='id: {0}'}" Classes="dim mono" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding Built}" Classes="dim" />
                  <TextBlock Text="{Binding Pack}" Classes="dim mono" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
              </Border>

              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Bundles that differ" FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <!-- Only the ones that differ: 2309 rows of "as shipped" would say nothing, and
                     what matters is which of them nothing here claims responsibility for. -->
                <ListBox ItemsSource="{Binding Bundles}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mods:BundleReport">
                      <StackPanel Margin="0,3">
                        <TextBlock Text="{Binding Bundle}" Classes="mono" />
                        <TextBlock Text="{Binding Explanation}" Classes="dim" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </DockPanel>
          </Grid>

          <!-- Anything that rewrites the game says what it is about to do first.

               The DataContext stays on the manager throughout: switching it to the confirmation
               for the text put the buttons out of reach of the commands, and they came out dead. -->
          <Border IsVisible="{Binding Asking, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Background="#cc09090b">
            <Border Background="#18181b" CornerRadius="6" Padding="20" MaxWidth="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Asking.Title}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Asking.Body}" Classes="dim" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Cancel" Command="{Binding DismissCommand}" />
                  <Button Content="Go ahead" Command="{Binding ProceedCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>
        </Panel>
      </TabItem>

    </TabControl>
  </DockPanel>

  </LayoutTransformControl>
</Window>
